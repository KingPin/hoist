# hoist.conf — copy to hoist.conf, /etc/hoist/hoist.conf, or set HOIST_CONFIG=/path/to/this
#
# Config is loaded at startup. CLI flags override config values.
# Discovery order: $HOIST_CONFIG → ./hoist.conf → /etc/hoist/hoist.conf

# Number of containers to process in parallel (default: 1)
# PARALLEL=4

# Directory for notification deduplication cache files (default: /tmp)
# CACHE_LOCATION=/var/cache/hoist

# Path to docker binary (default: $(which docker))
# DOCKER_BINARY=/usr/bin/docker

# Prune dangling images after each run (default: true)
# PRUNE_IMAGES=true

# Append all log output to this file in addition to stdout (default: disabled)
# LOG_FILE=/var/log/hoist.log

# Default tag filter — equivalent to passing --tag on every run (default: none)
# TAG=production

# Log containers skipped due to missing hoist labels (default: false). Automatically enabled by --dry-run.
# VERBOSE=true

# Maximum time in seconds for webhook HTTP requests (default: 30).
# CURL_TIMEOUT=30

# Only run during this time window (24h format HH:MM-HH:MM). Midnight-spanning works: "22:00-04:00".
# Leave empty to run any time. --dry-run bypasses this check.
# MAINTENANCE_WINDOW=02:00-06:00

# Global fallback webhooks — used for any container that has update/notify enabled
# but no per-container webhook label set. Per-container labels always take precedence.
# GLOBAL_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# GLOBAL_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# GLOBAL_GENERIC_WEBHOOK=https://example.com/webhook

# Additional channels (all optional). Each has matching per-container labels.
# GLOBAL_TELEGRAM_BOT_TOKEN=123456:ABC...
# GLOBAL_TELEGRAM_CHAT_ID=-1001234567890     # group chat IDs are negative
# GLOBAL_GOTIFY_URL=https://gotify.example.com/message?token=XXX
# GLOBAL_NTFY_URL=https://ntfy.sh/your-topic
# GLOBAL_NTFY_TOKEN=tk_...                   # optional, for protected topics
# GLOBAL_TEAMS_WEBHOOK=https://outlook.office.com/webhook/...
# GLOBAL_MATRIX_HOMESERVER=https://matrix.org
# GLOBAL_MATRIX_ROOM_ID=!abc123:matrix.org
# GLOBAL_MATRIX_TOKEN=syt_...

# Healthchecks.io heartbeat URL. Hoist pings <URL>/start at run start, the bare
# URL on success, and <URL>/fail if any container's update failed. Best-effort.
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>

# Webhook rollup mode — when true, suppress per-container webhooks for the listed
# channels and instead send a single summary webhook at the end of the run, using
# the corresponding GLOBAL_* URL. Per-container webhook labels are ignored for
# rolled-up channels. Channels not listed here continue to send per-container.
# WEBHOOK_ROLLUP=true
# WEBHOOK_ROLLUP_CHANNELS=discord,slack,generic,telegram,gotify,ntfy,teams,matrix

# Policy labels (set per container, not in this config):
#   com.sumguy.hoist.pause_until=YYYY-MM-DD or full ISO datetime — skip until reached
#   com.sumguy.hoist.constraint=^1.2 / ~1.2.3 / >=1 / <2 / =1.2.3 — semver pin against
#       new image's org.opencontainers.image.version label (notify still fires)
#   com.sumguy.hoist.group=<name>      — any group member's pull failure aborts the rest
#
# Container filters (CLI-only, no config equivalent):
#   --only foo,bar      include only these container names
#   --exclude foo,bar   skip these container names (wins over --only)

# Default timeout (seconds) for waiting on a container to become healthy after update,
# when its label .healthcheck.wait=true is set. Per-container .healthcheck.timeout overrides.
# HEALTHCHECK_TIMEOUT=120

# Poll interval (seconds) while waiting for a container to report healthy/running.
# HEALTHCHECK_INTERVAL=2

# When true, rollback applies to every updated container automatically — equivalent to
# setting com.sumguy.hoist.rollback=true on every label. Old image must still be on disk
# (PRUNE_IMAGES=true after a successful run will remove the rollback target).
# ROLLBACK_DEFAULT=false

# Self-update behavior on every run: "notify", "update", or "off" (default: notify)
#   notify — print to console + send to configured webhooks if a newer version exists
#   update — automatically apply updates (no prompt); still fires configured webhooks before applying
#   off    — never check for updates during normal runs
# WARNING: avoid "update" when running via cron — the script silently replaces itself on disk and
#          any breaking change in the new version will affect every subsequent unattended run.
#          Use "notify" (default) to receive alerts and apply updates manually instead.
# UPDATE_CHECK="notify"
